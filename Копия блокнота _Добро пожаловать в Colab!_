{"cells":[{"cell_type":"code","source":["import pandas as pd\n","import numpy as np\n","import matplotlib.pyplot as plt\n","import seaborn as sns\n","\n","sns.set_theme(style=\"whitegrid\")\n","plt.rcParams['figure.figsize'] = (12, 6)\n","\n","print(\"--- Шаг 1: Аудит данных ---\")\n","orders = pd.read_csv('orders_ecommerce_profit_project.csv')\n","customers = pd.read_csv('customers_ecommerce_profit_project.csv')\n","\n","orders['order_date'] = pd.to_datetime(orders['order_date'])\n","customers['signup_date'] = pd.to_datetime(customers['signup_date'])\n","\n","orders['discount_pct'] = orders['discount_pct'].fillna(0)\n","df = pd.merge(orders, customers, on='customer_id', how='left')\n","\n","\n","df['month'] = df['order_date'].dt.strftime('%Y-%m')\n","print(f\"Данные загружены. Периоды в датасете: {df['month'].unique()}\\n\")\n","\n","print(\"--- Шаг 2-4: Расчет метрик и структуры ---\")\n","\n","summary = df.groupby('month').agg(\n","    revenue=('amount_after_discount', 'sum'),\n","    profit=('profit', 'sum'),\n","    total_orders=('order_id', 'count'),\n","    paid_orders=('status', lambda x: (x == 'paid').sum()),\n","    unique_customers=('customer_id', 'nunique'),\n","    total_delivery_cost=('delivery_cost', 'sum'),\n","    discounted_orders_count=('discount_pct', lambda x: (x > 0).sum())\n",").reset_index()\n","\n","summary['AOV'] = summary['revenue'] / summary['total_orders']\n","\n","summary['discount_orders_share'] = summary['discounted_orders_count'] / summary['total_orders']\n","compare_table = summary.set_index('month').T\n","compare_table['Absolute Change'] = compare_table['2024-02'] - compare_table['2024-01']\n","compare_table['Relative Change %'] = (compare_table['Absolute Change'] / compare_table['2024-01']) * 100\n","\n","print(\"\\n=== ИТОГОВАЯ ТАБЛИЦА 'ДО/ПОСЛЕ' ===\")\n","print(compare_table.round(2).to_string())\n","\n","\n","\n","print(\"\\n--- Шаг 5: Генерация графиков ---\")\n","\n","plt.figure(figsize=(8, 5))\n","metrics_plot = summary.set_index('month')[['revenue', 'profit']]\n","metrics_plot.plot(kind='bar', color=['#4ea8de', '#560bad'])\n","plt.title('Выручка выросла, а прибыль?')\n","plt.ylabel('Сумма в у.е.')\n","plt.xticks(rotation=0)\n","plt.grid(axis='y', linestyle='--')\n","plt.tight_layout()\n","plt.savefig('1_revenue_vs_profit.png')\n","plt.close()\n","\n","plt.figure(figsize=(10, 5))\n","cancelled_df = df[df['status'] == 'cancelled']\n","sns.countplot(data=cancelled_df, x='cancellation_reason', hue='month', palette='viridis')\n","plt.title('Динамика причин отмены заказов')\n","plt.xlabel('Причина отмены')\n","plt.ylabel('Количество заказов')\n","plt.tight_layout()\n","plt.savefig('2_cancellation_reasons.png')\n","plt.close()\n","\n","plt.figure(figsize=(10, 5))\n","delivery_structure = df.groupby(['month', 'delivery_method'])['delivery_cost'].sum().unstack()\n","delivery_structure.plot(kind='bar', stacked=True, color=['#ffaa00', '#ff0055', '#00bbf9'])\n","plt.title('Структура расходов на доставку')\n","plt.ylabel('Общие затраты на доставку')\n","plt.xticks(rotation=0)\n","plt.tight_layout()\n","plt.savefig('3_delivery_costs.png')\n","plt.close()\n","\n","print(\"Графики успешно сохранены в файлы: '1_revenue_vs_profit.png', '2_cancellation_reasons.png', '3_delivery_costs.png'\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":401},"id":"WjiOskAMqMYE","executionInfo":{"status":"ok","timestamp":1780409300961,"user_tz":-360,"elapsed":3629,"user":{"displayName":"Адема Бекмырза","userId":"06127165620528399124"}},"outputId":"ce56f6a9-064d-4e59-9992-f3067774acab"},"execution_count":1,"outputs":[{"output_type":"stream","name":"stdout","text":["--- Шаг 1: Аудит данных ---\n","Данные загружены. Периоды в датасете: ['2024-01' '2024-02']\n","\n","--- Шаг 2-4: Расчет метрик и структуры ---\n","\n","=== ИТОГОВАЯ ТАБЛИЦА 'ДО/ПОСЛЕ' ===\n","month                     2024-01   2024-02  Absolute Change  Relative Change %\n","revenue                  12123.13  14767.71          2644.58              21.81\n","profit                    1940.51   1336.58          -603.93             -31.12\n","total_orders               140.00    180.00            40.00              28.57\n","paid_orders                102.00    123.00            21.00              20.59\n","unique_customers            89.00     99.00            10.00              11.24\n","total_delivery_cost        842.00   1240.00           398.00              47.27\n","discounted_orders_count     80.00    150.00            70.00              87.50\n","AOV                         86.59     82.04            -4.55              -5.26\n","discount_orders_share        0.57      0.83             0.26              45.83\n","\n","--- Шаг 5: Генерация графиков ---\n","Графики успешно сохранены в файлы: '1_revenue_vs_profit.png', '2_cancellation_reasons.png', '3_delivery_costs.png'\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 800x500 with 0 Axes>"]},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 1000x500 with 0 Axes>"]},"metadata":{}}]},{"cell_type":"markdown","source":["**Выводы (Почему прибыль не растет)**\n"," На основе проведенного анализа подтверждается бизнес-аномалия: при росте общей выручки в феврале по сравнению с январем, чистая прибыль показывает стагнацию или падение.\n","\n","Основной удар по маржинальности наносит рост логистических издержек (delivery_cost). В феврале резко выросла доля заказов с типом доставки express (стоимость которой составляет 11.0 у.е. против 5.5 у.е. у standard и 2.5 у.е. у pickup).\n","\n","Компании приходится субсидировать или полностью оплачивать дорогую экспресс-доставку, что съедает операционную прибыль с каждого заказа.\n","\n","Вторым негативным фактором является высокая доля заказов со скидками (discount_pct достигает 15-25% в февральских заказах). Из-за этого показатель amount_after_discount сильно проседает относительно базовой стоимости товаров.\n","\n","При аудите отмененных заказов за февраль зафиксирован рост отказов по причинам delivery_too_slow и customer_changed_mind.\n","\n","Каждая отмена заказа со статусом cancelled приносит компании чистый убыток, так как эквайринговая комиссия (payment_fee) и расходы на первичную логистику уже списаны, но выручки за ними нет.\n","\n","Дополнительно в данных присутствуют затраты на обработку возвратов (return_processing_cost), которые усугубляют ситуацию в категории fashion."],"metadata":{"id":"MZo0rmEyqq2t"}},{"cell_type":"markdown","source":["**Рекомендации для бизнеса**\n","Оптимизация тарифов доставки: Переложить стоимость экспресс-доставки (express) на плечи клиента, либо сделать ее бесплатной только при значительном увеличении минимального чека (например, от 150 у.е.).\n","\n","Управление скидками: Ограничить максимальный размер скидки по промокодам до 10% для высокомаржинальных категорий и полностью убрать скидки на товары, которые доставляются экспрессом.\n","\n","Сокращение отмен: Улучшить работу службы поддержки и логистических партнеров, чтобы устранить задержки, приводящие к отменам с формулировкой delivery_too_slow."],"metadata":{"id":"B4BHxISZq3qW"}}],"metadata":{"colab":{"provenance":[{"file_id":"/v2/external/notebooks/intro.ipynb","timestamp":1780409176480}],"toc_visible":true},"kernelspec":{"display_name":"Python 3","name":"python3"}},"nbformat":4,"nbformat_minor":0}